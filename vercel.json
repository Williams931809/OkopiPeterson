{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/health",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/health"
    },
    {
      "source": "/api/products",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/products"
    },
    {
      "source": "/api/store-settings",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/store-settings"
    },
    {
      "source": "/api/orders/:id",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/orders/:id"
    },
    {
      "source": "/api/orders",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/orders"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/admin/:path*"
    },
    {
      "source": "/api/pages",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/pages"
    },
    {
      "source": "/api/checkout-quote",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/checkout-quote"
    },
    {
      "source": "/pages/:slug",
      "destination": "/custom-page.html"
    },
    {
      "source": "/track-order",
      "destination": "/track-order.html"
    },
    {
      "source": "/api/track-order",
      "destination": "https://maisonpe-api.thankgododiawa6.workers.dev/api/track-order"
    }
  ]
}
